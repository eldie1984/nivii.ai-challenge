# Server Configuration
PORT=3000
DEBUG=false

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_tracker

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Microservice URLs
CRYPTOCURRENCY_SERVICE_URL=http://cryptocurrency-service:3005
PORTFOLIO_SERVICE_URL=http://portfolio-service:3002
AGENT_ORCHESTRATOR_URL=http://agent-orchestrator:3003

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
